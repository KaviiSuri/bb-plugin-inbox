{
  "name": "bb-plugin-inbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A fork of bb's sidebar thread list that adds an Inbox tab for triaging agent work.",
  "engines": {
    "bb": ">=0.0",
    "bbPluginSdk": ">=0.6.112"
  },
  "bb": {
